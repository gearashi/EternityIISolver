* text=auto eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.cu text eol=lf
*.cl text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Hash-verified source datasets must retain their original bytes.
data/** -text whitespace=cr-at-eol
*.png binary
*.zip binary
*.gz binary

# Retain byte-level checksums of recorded experimental evidence.
docs/evidence/*.json -text whitespace=cr-at-eol
